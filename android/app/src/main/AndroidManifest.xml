<?xml version="1.0" encoding="utf-8"?>
<!-- shank1-nx on Android: a launcher (imports the user's own copy of the game, sets the port's options, starts it) and
     the game itself, which is the recompiled program in libmain.so (SDL3's Android activity loads it). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Touch controls' haptics. Everything else (the game data) comes through the storage access framework, which
         needs no permission. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The renderer is plume's Vulkan backend: no Vulkan, no game. ETC2 is mandatory in Vulkan 1.0, so no separate
         texture-compression feature is required (docs/android.md, "Textures: ETC2 or not?"). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen.multitouch.jazzhand" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Shank1Theme">

        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:theme="@style/Shank1Theme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".LauncherActivity" />

        <activity
            android:name=".ControlsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:exported="false"
            android:label="@string/controls_title"
            android:parentActivityName=".LauncherActivity" />

        <!-- The game. SDL3's own activity does the surface, the input devices and the lifecycle; the port adds the
             touch overlay, the frame work and the performance hooks (docs/android.md). -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Shank1Theme.Game">

            <!-- SDL3 reads the name of the activity's native library here. -->
            <meta-data android:name="android.app.lib_name" android:value="main" />
        </activity>
    </application>
</manifest>
